# ─── Configuración SMTP ────────────────────────────
# Si usas tu dominio dr-asesoria.com, pídele a Dondominio los datos SMTP.
# Para Gmail, debes generar un "App Password" (no la contraseña normal).

SMTP_HOST=smtp.dondominio.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@dr-asesoria.com
SMTP_PASS=tu-contraseña-smtp

# A quién avisar
NOTIFY_TO=tu-email@dr-asesoria.com
NOTIFY_FROM=tu-cuenta@dr-asesoria.com
